# Copier en .env puis adapter
# Port hôte du PostgreSQL docker (voir infra/docker-compose.yml — SIKA_PG_PORT)
DATABASE_URL=postgres://sika:sika_dev@localhost:5432/sika

PORT=3000

# JWT (POST /auth/login)
JWT_SECRET=change-moi-en-local
JWT_EXPIRES_IN=12h

# MinIO / stockage photos (infra/docker-compose.yml)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=sika
MINIO_ROOT_PASSWORD=sika_dev_minio

# Simulateur Mobile Money (packages/payments) — démo uniquement.
# disponible (défaut) | indisponible (joue le chemin ERR-502) | refus
SIKA_MM_SIMULATION=disponible
